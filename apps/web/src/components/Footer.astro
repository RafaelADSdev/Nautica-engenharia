---
import { Icon } from 'astro-icon/components';
import type { SiteSettings } from '../data/types';
import { optimizedImageSrc } from '../lib/images';

interface Props {
  settings: SiteSettings;
}

const { settings } = Astro.props;
const year = new Date().getFullYear();
const logoSrc = optimizedImageSrc('/assets/brand/logo-nautica.png', 320);
---

<footer class="site-footer">
  <div class="container footer-grid">
    <div class="footer-brand">
      <img src={logoSrc} alt="Náutica Engenharia e Serviços" width="120" height="120" loading="lazy" decoding="async" />
      <p>Engenharia para estruturas seguras, operações contínuas e negócios que precisam avançar.</p>
    </div>
    <div>
      <h2>Contato</h2>
      <ul>
        <li><Icon name="lucide:map-pin" size={18} aria-hidden="true" /><span>{settings.address.formatted}</span></li>
        {settings.phones.map((phone) => <li><Icon name="lucide:phone" size={18} aria-hidden="true" /><a href={phone.href}>{phone.value}</a></li>)}
        <li><Icon name="lucide:mail" size={18} aria-hidden="true" /><a href={`mailto:${settings.email}`}>{settings.email}</a></li>
      </ul>
    </div>
    <div>
      <h2>Navegação</h2>
      <ul class="footer-nav">
        <li><a href="/#quem-somos">Quem somos</a></li>
        <li><a href="/#servicos">Serviços</a></li>
        <li><a href="/#cases">Cases</a></li>
        <li><a href="/#parceiros">Parceiros</a></li>
        <li><a href="/terms-and-conditions">Termos e condições</a></li>
        <li><a href="/privacy-policy">Política de privacidade</a></li>
      </ul>
    </div>
  </div>
  <div class="container footer-bottom">
    <span>© {year} {settings.legalName}.</span>
    <a href={settings.whatsapp.baseUrl} target="_blank" rel="noopener noreferrer">WhatsApp <Icon name="lucide:arrow-up-right" size={15} aria-hidden="true" /></a>
  </div>
</footer>

<style>
  .site-footer {
    color: rgb(255 255 255 / 74%);
    background: var(--graphite);
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 1.2fr 1fr 0.8fr;
    gap: clamp(40px, 8vw, 96px);
    padding-block: 72px;
  }

  .footer-brand img {
    width: 96px;
    margin-bottom: 22px;
  }

  .footer-brand p {
    max-width: 390px;
    margin-bottom: 0;
  }

  h2 {
    margin-bottom: 22px;
    color: var(--white);
    font-family: "Montserrat", sans-serif;
    font-size: 0.8rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  ul {
    display: grid;
    gap: 12px;
    padding: 0;
    margin: 0;
    list-style: none;
  }

  li {
    display: flex;
    align-items: flex-start;
    gap: 10px;
  }

  a {
    color: inherit;
  }

  a:hover {
    color: var(--white);
  }

  .footer-bottom {
    display: flex;
    min-height: 76px;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    border-top: 1px solid rgb(255 255 255 / 12%);
    font-size: 0.83rem;
  }

  .footer-bottom a {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-weight: 700;
    text-decoration: none;
  }

  @media (max-width: 820px) {
    .footer-grid {
      grid-template-columns: 1fr;
      gap: 40px;
    }
  }

  @media (max-width: 540px) {
    .footer-bottom {
      align-items: flex-start;
      flex-direction: column;
      justify-content: center;
      padding-block: 20px;
    }
  }
</style>
