---
import { Icon } from 'astro-icon/components';
import type { ImageAsset } from '../data/types';
import { optimizedImageSrc, optimizedImageSrcSet } from '../lib/images';

interface Props {
  images: ImageAsset[];
  title?: string;
  eyebrow?: string;
}

const { images, title = 'Registros da execução', eyebrow = 'Galeria' } = Astro.props;
const dialogId = `gallery-${Math.random().toString(36).slice(2, 8)}`;
const optimizedItems = images.map((item) => ({ ...item, src: optimizedImageSrc(item.src) }));
---

{images.length > 0 && (
  <section class="section gallery-section" aria-labelledby={`${dialogId}-title`} data-gallery data-items={JSON.stringify(optimizedItems)}>
    <div class="container">
      <div class="gallery-heading">
        <div>
          <span class="eyebrow">{eyebrow}</span>
          <h2 id={`${dialogId}-title`}>{title}</h2>
        </div>
        <p>Selecione uma imagem para visualizar em tamanho ampliado.</p>
      </div>

      <div class="gallery-grid">
        {images.map((item, index) => (
          <button
            class:list={['gallery-item', { 'gallery-item--wide': index === 0 }]}
            type="button"
            data-lightbox-open
            data-index={index}
            aria-label={`Ampliar imagem ${index + 1} de ${images.length}: ${item.alt}`}
          >
            <img
              src={optimizedImageSrc(item.src)}
              srcset={optimizedImageSrcSet(item.src)}
              sizes="(max-width: 720px) calc(100vw - 28px), 33vw"
              alt={item.alt}
              width="900"
              height="680"
              loading="lazy"
              decoding="async"
            />
            <span><Icon name="lucide:maximize-2" size={20} aria-hidden="true" /></span>
          </button>
        ))}
      </div>
    </div>

    <dialog id={dialogId} class="lightbox" role="dialog" aria-modal="true" aria-label="Visualização ampliada da galeria" data-lightbox>
      <div class="lightbox-shell">
        <div class="lightbox-toolbar">
          <span data-lightbox-counter></span>
          <button type="button" data-lightbox-close aria-label="Fechar galeria"><Icon name="lucide:x" size={24} aria-hidden="true" /></button>
        </div>
        <figure>
          <img src={optimizedItems[0].src} alt={optimizedItems[0].alt} width="1600" height="1100" loading="lazy" decoding="async" data-lightbox-image />
          <figcaption data-lightbox-caption>{images[0].caption ?? images[0].alt}</figcaption>
        </figure>
        <div class="lightbox-nav">
          <button type="button" data-lightbox-prev><Icon name="lucide:arrow-left" size={19} aria-hidden="true" /> Anterior</button>
          <button type="button" data-lightbox-next>Próxima <Icon name="lucide:arrow-right" size={19} aria-hidden="true" /></button>
        </div>
      </div>
    </dialog>
  </section>
)}

<script>
  interface GalleryItem {
    src: string;
    alt: string;
    caption?: string;
  }

  document.querySelectorAll<HTMLElement>('[data-gallery]').forEach((gallery) => {
    const dialog = gallery.querySelector<HTMLDialogElement>('[data-lightbox]');
    const image = dialog?.querySelector<HTMLImageElement>('[data-lightbox-image]');
    const caption = dialog?.querySelector<HTMLElement>('[data-lightbox-caption]');
    const counter = dialog?.querySelector<HTMLElement>('[data-lightbox-counter]');
    const items = JSON.parse(gallery.dataset.items ?? '[]') as GalleryItem[];
    let activeIndex = 0;
    let trigger: HTMLElement | null = null;

    const render = () => {
      const item = items[activeIndex];
      if (image && item) {
        image.src = item.src;
        image.alt = item.alt;
      }
      if (caption) caption.textContent = item?.caption || item?.alt || '';
      if (counter) counter.textContent = `${activeIndex + 1} / ${items.length}`;
    };

    const close = () => dialog?.close();
    gallery.querySelectorAll<HTMLElement>('[data-lightbox-open]').forEach((button) => {
      button.addEventListener('click', () => {
        if (!dialog) return;
        activeIndex = Number(button.dataset.index ?? 0);
        trigger = button;
        render();
        dialog.showModal();
        dialog.querySelector<HTMLElement>('[data-lightbox-close]')?.focus();
      });
    });
    dialog?.querySelector('[data-lightbox-close]')?.addEventListener('click', close);
    dialog?.querySelector('[data-lightbox-prev]')?.addEventListener('click', () => {
      activeIndex = (activeIndex - 1 + items.length) % items.length;
      render();
    });
    dialog?.querySelector('[data-lightbox-next]')?.addEventListener('click', () => {
      activeIndex = (activeIndex + 1) % items.length;
      render();
    });
    dialog?.addEventListener('click', (event) => {
      if (event.target === dialog) close();
    });
    dialog?.addEventListener('keydown', (event) => {
      if (event.key === 'ArrowLeft') {
        activeIndex = (activeIndex - 1 + items.length) % items.length;
        render();
      }
      if (event.key === 'ArrowRight') {
        activeIndex = (activeIndex + 1) % items.length;
        render();
      }
    });
    dialog?.addEventListener('close', () => trigger?.focus());
  });
</script>

<style>
  .gallery-section {
    background: var(--graphite);
  }

  .gallery-heading {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(280px, 0.8fr);
    align-items: end;
    gap: 48px;
    margin-bottom: 38px;
  }

  .gallery-heading .eyebrow {
    color: #ffb29c;
  }

  .gallery-heading h2 {
    margin-bottom: 0;
    color: var(--white);
  }

  .gallery-heading p {
    margin-bottom: 4px;
    color: rgb(255 255 255 / 65%);
  }

  .gallery-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 14px;
  }

  .gallery-item {
    position: relative;
    aspect-ratio: 1 / 0.82;
    padding: 0;
    overflow: hidden;
    border: 0;
    border-radius: var(--radius-sm);
    background: #1e1e20;
    cursor: zoom-in;
  }

  .gallery-item--wide {
    grid-column: span 2;
  }

  .gallery-item img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 300ms ease;
  }

  .gallery-item > span {
    position: absolute;
    right: 14px;
    bottom: 14px;
    display: grid;
    width: 44px;
    height: 44px;
    place-items: center;
    border-radius: 50%;
    color: var(--white);
    background: rgb(23 26 0 / 76%);
    backdrop-filter: blur(8px);
  }

  .gallery-item:hover img,
  .gallery-item:focus-visible img {
    transform: scale(1.035);
  }

  .lightbox {
    width: min(1100px, calc(100% - 28px));
    max-width: none;
    max-height: calc(100svh - 28px);
    padding: 0;
    overflow: hidden;
    border: 1px solid rgb(255 255 255 / 20%);
    border-radius: var(--radius-md);
    color: var(--white);
    background: #161618;
  }

  .lightbox::backdrop {
    background: rgb(0 0 0 / 88%);
    backdrop-filter: blur(6px);
  }

  .lightbox-shell {
    display: grid;
    max-height: calc(100svh - 28px);
    grid-template-rows: auto minmax(0, 1fr) auto;
  }

  .lightbox-toolbar,
  .lightbox-nav {
    display: flex;
    min-height: 60px;
    align-items: center;
    justify-content: space-between;
    gap: 18px;
    padding: 10px 18px;
  }

  .lightbox-toolbar {
    border-bottom: 1px solid rgb(255 255 255 / 12%);
  }

  .lightbox-toolbar > span {
    font-size: 0.8rem;
    font-weight: 800;
  }

  .lightbox button {
    display: inline-flex;
    min-height: 42px;
    align-items: center;
    gap: 8px;
    border: 1px solid rgb(255 255 255 / 18%);
    border-radius: 999px;
    color: var(--white);
    background: rgb(255 255 255 / 8%);
    cursor: pointer;
    font-size: 0.78rem;
    font-weight: 800;
  }

  .lightbox-toolbar button {
    width: 42px;
    justify-content: center;
    padding: 0;
  }

  figure {
    display: grid;
    min-height: 0;
    margin: 0;
  }

  figure img {
    width: 100%;
    height: min(72svh, 760px);
    object-fit: contain;
    background: #0b0b0c;
  }

  figcaption {
    padding: 10px 20px;
    color: rgb(255 255 255 / 66%);
    font-size: 0.75rem;
  }

  .lightbox-nav {
    border-top: 1px solid rgb(255 255 255 / 12%);
  }

  .lightbox-nav button {
    padding: 8px 14px;
  }

  @media (max-width: 820px) {
    .gallery-heading {
      grid-template-columns: 1fr;
      gap: 16px;
    }

    .gallery-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 520px) {
    .gallery-grid {
      grid-template-columns: 1fr;
    }

    .gallery-item--wide {
      grid-column: auto;
    }
  }
</style>
