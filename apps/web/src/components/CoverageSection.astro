---
import { Icon } from 'astro-icon/components';
import { homePage as localHomePage, states as localStates } from '../data/site';
import type { HomePageContent, StateCoverage } from '../data/types';

interface Props {
  content?: HomePageContent;
  states?: StateCoverage[];
}

const { content = localHomePage, states = localStates } = Astro.props;
---

<section class="section coverage" aria-labelledby="coverage-title">
  <div class="container coverage-grid">
    <div class="coverage-copy" data-reveal="right">
      <span class="eyebrow">{content.coverage.eyebrow}</span>
      <h2 id="coverage-title">{content.coverage.title}</h2>
      <p>{content.coverage.description}</p>
      <div class="coverage-notes">
        <div class="hq-note"><Icon name="lucide:building-2" size={20} aria-hidden="true" /><span><strong>Sede em Recife</strong> — atendimento regional planejado conforme cada operação.</span></div>
        <div class="hq-note"><Icon name="lucide:map-pin" size={20} aria-hidden="true" /><span>{content.coverage.reachNote}</span></div>
      </div>
    </div>

    <div class="coverage-map" aria-label="Estados atendidos pela Náutica Engenharia" data-reveal="left" data-reveal-delay="140">
      <div class="map-rings" aria-hidden="true"><i></i><i></i><i></i></div>
      <ul>
        {states.map((state, index) => (
          <li class:list={{ headquarters: state.isHeadquarters }} data-reveal="scale" data-reveal-delay={String(200 + index * 70)}>
            <div class="state-flag">
              <img src={state.flag} alt={`Bandeira de ${state.name}`} width="46" height="46" loading="lazy" decoding="async" />
            </div>
            <span>{state.name}{state.isHeadquarters ? ' — sede' : ''}</span>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>

<style>
  .coverage {
    overflow: hidden;
    background: var(--sand);
  }

  .coverage-grid {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    align-items: center;
    gap: clamp(48px, 9vw, 120px);
  }

  h2 {
    margin-bottom: 24px;
  }

  .coverage-copy > p {
    max-width: 600px;
    color: var(--ink-muted);
  }

  .coverage-notes {
    display: grid;
    gap: 12px;
    margin-top: 30px;
  }

  .hq-note {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 13px;
    padding: 20px;
    border-left: 4px solid var(--brand-orange-dark);
    border-radius: 0 var(--radius-sm) var(--radius-sm) 0;
    background: var(--white);
    box-shadow: var(--shadow-sm);
  }

  .hq-note :global(svg) {
    color: var(--brand-orange-dark);
  }

  .hq-note span {
    color: var(--ink-muted);
    font-size: 0.86rem;
  }

  .hq-note strong {
    color: var(--graphite);
  }

  .coverage-map {
    position: relative;
    min-height: 510px;
    padding: clamp(28px, 5vw, 58px);
    overflow: hidden;
    border-radius: var(--radius-lg);
    color: var(--white);
    background: var(--graphite);
    box-shadow: var(--shadow-lg);
  }

  .map-rings,
  .map-rings i {
    position: absolute;
    border: 1px solid rgb(255 255 255 / 10%);
    border-radius: 50%;
  }

  .map-rings {
    top: 50%;
    right: -18%;
    width: 460px;
    height: 460px;
    transform: translateY(-50%);
  }

  .map-rings i:nth-child(1) { inset: 55px; animation: map-pulse 4.8s ease-in-out infinite; }
  .map-rings i:nth-child(2) { inset: 120px; animation: map-pulse 4.8s ease-in-out infinite 0.8s; }
  .map-rings i:nth-child(3) { inset: 180px; border-color: var(--brand-orange); animation: map-pulse 4.8s ease-in-out infinite 1.6s; }

  @keyframes map-pulse {
    0%,
    100% {
      opacity: 0.45;
      transform: scale(1);
    }

    50% {
      opacity: 1;
      transform: scale(1.03);
    }
  }

  ul {
    position: relative;
    z-index: 1;
    display: grid;
    gap: 10px;
    padding: 0;
    margin: 0;
    list-style: none;
  }

  li {
    display: grid;
    grid-template-columns: 64px 1fr;
    align-items: center;
    min-height: 66px;
    padding: 10px 18px 10px 10px;
    border: 1px solid rgb(255 255 255 / 11%);
    border-radius: var(--radius-sm);
    background: rgb(255 255 255 / 6%);
    backdrop-filter: blur(5px);
  }

  .state-flag {
    display: grid;
    width: 46px;
    height: 46px;
    overflow: hidden;
    border: 2px solid rgb(255 255 255 / 22%);
    border-radius: 50%;
    background: rgb(255 255 255 / 92%);
    box-shadow: 0 6px 16px rgb(0 0 0 / 22%);
    place-items: center;
  }

  .state-flag img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  li.headquarters {
    margin: 0;
    border-left: 1px solid var(--brand-orange);
    background: rgb(240 92 54 / 18%);
    box-shadow: none;
  }

  li.headquarters .state-flag {
    border-color: rgb(255 177 156 / 70%);
    box-shadow: 0 0 0 2px rgb(240 92 54 / 28%);
  }

  li span {
    font-size: 0.88rem;
    font-weight: 700;
  }

  @media (max-width: 860px) {
    .coverage-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 520px) {
    .coverage-map {
      min-height: auto;
    }
  }
</style>
