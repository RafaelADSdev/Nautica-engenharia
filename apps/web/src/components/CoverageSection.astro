---
import { Icon } from 'astro-icon/components';
import { homePage as localHomePage, states as localStates } from '../data/site';
import type { HomePageContent, StateCoverage } from '../data/types';

interface Props {
  content?: HomePageContent;
  states?: StateCoverage[];
}

const { content = localHomePage, states = localStates } = Astro.props;
---

<section class="section coverage" aria-labelledby="coverage-title">
  <div class="container coverage-grid">
    <div class="coverage-copy">
      <span class="eyebrow">{content.coverage.eyebrow}</span>
      <h2 id="coverage-title">{content.coverage.title}</h2>
      <p>{content.coverage.description}</p>
      <div class="hq-note"><Icon name="lucide:building-2" size={20} aria-hidden="true" /><span><strong>Sede em Recife</strong> — atendimento regional planejado conforme cada operação.</span></div>
    </div>

    <div class="coverage-map" aria-label="Estados atendidos pela Náutica Engenharia">
      <div class="map-rings" aria-hidden="true"><i></i><i></i><i></i></div>
      <ul>
        {states.map((state) => (
          <li class:list={{ headquarters: state.isHeadquarters }}>
            <strong>{state.code}</strong>
            <span>{state.name}{state.isHeadquarters ? ' — sede' : ''}</span>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>

<style>
  .coverage {
    overflow: hidden;
    background: var(--sand);
  }

  .coverage-grid {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    align-items: center;
    gap: clamp(48px, 9vw, 120px);
  }

  h2 {
    margin-bottom: 24px;
  }

  .coverage-copy > p {
    max-width: 600px;
    color: var(--ink-muted);
  }

  .hq-note {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 13px;
    margin-top: 30px;
    padding: 20px;
    border-left: 4px solid var(--brand-orange-dark);
    border-radius: 0 var(--radius-sm) var(--radius-sm) 0;
    background: var(--white);
    box-shadow: var(--shadow-sm);
  }

  .hq-note :global(svg) {
    color: var(--brand-orange-dark);
  }

  .hq-note span {
    color: var(--ink-muted);
    font-size: 0.86rem;
  }

  .hq-note strong {
    color: var(--graphite);
  }

  .coverage-map {
    position: relative;
    min-height: 510px;
    padding: clamp(28px, 5vw, 58px);
    overflow: hidden;
    border-radius: var(--radius-lg);
    color: var(--white);
    background: var(--graphite);
    box-shadow: var(--shadow-lg);
  }

  .map-rings,
  .map-rings i {
    position: absolute;
    border: 1px solid rgb(255 255 255 / 10%);
    border-radius: 50%;
  }

  .map-rings {
    top: 50%;
    right: -18%;
    width: 460px;
    height: 460px;
    transform: translateY(-50%);
  }

  .map-rings i:nth-child(1) { inset: 55px; }
  .map-rings i:nth-child(2) { inset: 120px; }
  .map-rings i:nth-child(3) { inset: 180px; border-color: var(--brand-orange); }

  ul {
    position: relative;
    z-index: 1;
    display: grid;
    gap: 10px;
    padding: 0;
    margin: 0;
    list-style: none;
  }

  li {
    display: grid;
    grid-template-columns: 64px 1fr;
    align-items: center;
    min-height: 66px;
    padding: 10px 18px 10px 10px;
    border: 1px solid rgb(255 255 255 / 11%);
    border-radius: var(--radius-sm);
    background: rgb(255 255 255 / 6%);
    backdrop-filter: blur(5px);
  }

  li strong {
    display: grid;
    width: 46px;
    height: 46px;
    place-items: center;
    border-radius: 50%;
    color: var(--white);
    background: var(--olive-accent);
    font-family: 'Lemon Milk', sans-serif;
  }

  li.headquarters {
    margin: 0;
    border-left: 1px solid var(--brand-orange);
    background: rgb(240 92 54 / 18%);
    box-shadow: none;
  }

  li.headquarters strong {
    background: var(--brand-orange-dark);
  }

  li span {
    font-size: 0.88rem;
    font-weight: 700;
  }

  @media (max-width: 860px) {
    .coverage-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 520px) {
    .coverage-map {
      min-height: auto;
    }
  }
</style>
