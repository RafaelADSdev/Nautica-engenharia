---
interface Metric {
  value: string;
  label: string;
}

interface Props {
  metrics?: Metric[];
}

const defaultMetrics = [
  { value: '10+', label: 'anos construindo confiança' },
  { value: '9', label: 'frentes de serviço especializadas' },
  { value: '5', label: 'estados atendidos no Nordeste' },
  { value: '25', label: 'marcas apresentadas no portfólio' },
];

const { metrics = defaultMetrics } = Astro.props;
---

<section class="trust-bar" aria-label="Números da Náutica Engenharia">
  {metrics.map((metric) => (
    <div class="metric">
      <strong>{metric.value}</strong>
      <span>{metric.label}</span>
    </div>
  ))}
</section>

<style>
  .trust-bar {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    border-bottom: 1px solid var(--line);
    background: var(--white);
  }

  .metric {
    display: flex;
    min-width: 0;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 8px;
    min-height: 112px;
    padding: 22px clamp(12px, 2vw, 28px);
    border-left: 1px solid var(--line);
    text-align: center;
  }

  .metric:last-child {
    border-right: 1px solid var(--line);
  }

  strong {
    color: var(--brand-orange-dark);
    font-family: "Lemon Milk", "Montserrat", sans-serif;
    font-size: clamp(1.35rem, 1.8vw, 2rem);
    line-height: 1.1;
    text-wrap: balance;
  }

  span {
    max-width: 16ch;
    color: var(--ink-muted);
    font-size: 0.76rem;
    font-weight: 700;
    line-height: 1.35;
    text-wrap: balance;
  }

  @media (max-width: 860px) {
    .trust-bar {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .metric:nth-child(3),
    .metric:nth-child(4) {
      border-top: 1px solid var(--line);
    }

    .metric:nth-child(odd) {
      border-left: none;
    }

    .metric:nth-child(even) {
      border-right: 1px solid var(--line);
    }
  }

  @media (max-width: 460px) {
    .trust-bar {
      grid-template-columns: 1fr;
    }

    .metric {
      border-top: 1px solid var(--line);
      border-left: none;
      border-right: none;
    }

    .metric:first-child {
      border-top: none;
    }

    .metric:last-child {
      border-right: none;
    }
  }
</style>
