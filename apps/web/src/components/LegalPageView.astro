---
import type { LegalPage } from '../data/types';
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from './Breadcrumbs.astro';

interface Props {
  page: LegalPage;
}

const { page } = Astro.props;
---

<BaseLayout
  title={page.seo.title}
  description={page.seo.description}
  canonicalPath={`/${page.slug}`}
  noIndex={page.seo.noIndex}
>
  <header class="legal-hero">
    <div class="container legal-hero-inner">
      <Breadcrumbs items={[{ label: 'Início', href: '/' }, { label: page.title }]} light />
      <span>Informações legais</span>
      <h1>{page.title}</h1>
      <p>{page.introduction}</p>
    </div>
  </header>

  <section class="section legal-content">
    <div class="container legal-grid">
      <aside>
        <strong>Nesta página</strong>
        <nav aria-label={`Seções de ${page.title}`}>
          {page.sections.map((section, index) => <a href={`#secao-${index + 1}`}>{section.heading}</a>)}
        </nav>
      </aside>
      <article>
        {page.sections.map((section, index) => (
          <section id={`secao-${index + 1}`}>
            <h2>{section.heading}</h2>
            {section.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
            {section.items && <ul>{section.items.map((item) => <li>{item}</li>)}</ul>}
          </section>
        ))}
      </article>
    </div>
  </section>
</BaseLayout>

<style>
  .legal-hero {
    color: var(--white);
    background:
      radial-gradient(circle at 80% 20%, rgb(240 92 54 / 28%), transparent 28%),
      var(--graphite);
  }

  .legal-hero-inner {
    padding-block: 150px 72px;
  }

  .legal-hero-inner > span {
    display: block;
    margin: 42px 0 14px;
    color: #ffb29c;
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  h1 {
    margin-bottom: 24px;
    color: var(--white);
    font-size: clamp(2.6rem, 5vw, 4.8rem);
  }

  .legal-hero p {
    max-width: 800px;
    margin-bottom: 0;
    color: rgb(255 255 255 / 75%);
  }

  .legal-grid {
    display: grid;
    grid-template-columns: 280px minmax(0, 760px);
    justify-content: space-between;
    gap: 70px;
  }

  aside {
    position: sticky;
    top: 120px;
    align-self: start;
    padding: 24px;
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
    background: var(--sand);
  }

  aside > strong {
    display: block;
    margin-bottom: 14px;
    font-size: 0.78rem;
    text-transform: uppercase;
  }

  aside nav {
    display: grid;
  }

  aside a {
    padding: 9px 0;
    border-top: 1px solid var(--line);
    color: var(--ink-muted);
    font-size: 0.75rem;
  }

  article > section {
    scroll-margin-top: 120px;
    padding-bottom: 40px;
    margin-bottom: 40px;
    border-bottom: 1px solid var(--line);
  }

  article > section:last-child {
    padding-bottom: 0;
    margin-bottom: 0;
    border-bottom: 0;
  }

  article h2 {
    margin-bottom: 18px;
    font-family: 'Montserrat', sans-serif;
    font-size: clamp(1.35rem, 2.6vw, 1.85rem);
  }

  article p,
  article li {
    color: var(--ink-muted);
  }

  @media (max-width: 840px) {
    .legal-grid {
      grid-template-columns: 1fr;
      gap: 40px;
    }

    aside {
      position: static;
    }
  }
</style>
