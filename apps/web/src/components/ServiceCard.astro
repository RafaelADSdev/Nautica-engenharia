---
import { Icon } from 'astro-icon/components';
import type { Service } from '../data/types';
import { optimizedImageSrc, optimizedImageSrcSet } from '../lib/images';

interface Props {
  service: Service;
  index?: number;
  priority?: boolean;
}

const { service, index = 0, priority = false } = Astro.props;
const preferredImageIndex = service.slug === 'terceirizacao-mao-de-obra' ? 3 : 0;
const cardImage = service.gallery[preferredImageIndex] ?? service.gallery[0] ?? service.heroImage;
const cardImageSrc = optimizedImageSrc(cardImage.src);
const cardImageSrcSet = optimizedImageSrcSet(cardImage.src);
---

<article class="service-card" data-reveal data-reveal-delay={String(index * 70)}>
  <a href={`/${service.slug}`} aria-label={`Conheça o serviço de ${service.title}`}>
    <div class="service-media">
      <img
        src={cardImageSrc}
        srcset={cardImageSrcSet}
        sizes="(max-width: 700px) calc(100vw - 28px), (max-width: 1050px) 48vw, 31vw"
        alt={cardImage.alt}
        width="720"
        height="480"
        loading={priority ? 'eager' : 'lazy'}
        fetchpriority={priority ? 'high' : 'auto'}
        decoding="async"
      />
      <span class="service-icon"><Icon name={service.icon} size={28} aria-hidden="true" /></span>
    </div>
    <div class="service-copy">
      <span class="service-number">{String(index + 1).padStart(2, '0')}</span>
      <h3>{service.title}</h3>
      <p>{service.summary}</p>
      <span class="service-link">Saiba mais <Icon name="lucide:arrow-right" size={18} aria-hidden="true" /></span>
    </div>
  </a>
</article>

<style>
  .service-card {
    position: relative;
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: var(--radius-md);
    background: var(--white);
    box-shadow: 0 0 0 rgb(45 45 48 / 0%);
    transition:
      transform var(--transition),
      border-color var(--transition),
      box-shadow var(--transition);
  }

  .service-card:hover,
  .service-card:focus-within {
    transform: translateY(-6px);
    border-color: var(--brand-orange);
    box-shadow: var(--shadow-sm);
  }

  a {
    display: grid;
    height: 100%;
    color: inherit;
    text-decoration: none;
  }

  .service-media {
    position: relative;
    overflow: hidden;
    aspect-ratio: 3 / 2;
    background: var(--sand);
  }

  .service-media::after {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, transparent 50%, rgb(23 26 0 / 30%));
    content: "";
  }

  img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 500ms cubic-bezier(0.2, 0.7, 0.2, 1);
  }

  .service-card:hover img {
    transform: scale(1.035);
  }

  .service-icon {
    position: absolute;
    z-index: 1;
    right: 20px;
    bottom: 18px;
    display: grid;
    width: 52px;
    height: 52px;
    place-items: center;
    border-radius: 50%;
    color: var(--white);
    background: var(--brand-orange-dark);
  }

  .service-copy {
    display: grid;
    grid-template-columns: auto 1fr;
    column-gap: 18px;
    padding: 24px;
  }

  .service-number {
    grid-row: 1 / 4;
    color: var(--brand-orange-dark);
    font-size: 0.74rem;
    font-weight: 900;
    letter-spacing: 0.08em;
  }

  h3 {
    margin-bottom: 12px;
  }

  p {
    margin-bottom: 20px;
    color: var(--ink-muted);
    font-size: 0.92rem;
  }

  .service-link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: var(--brand-orange-dark);
    font-size: 0.84rem;
    font-weight: 800;
  }
</style>
