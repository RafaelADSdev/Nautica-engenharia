---
import { Icon } from 'astro-icon/components';
import type { Partner, Service } from '../data/types';
import { getWhatsAppUrl, partners as localPartners, services as localServices } from '../data/site';
import BaseLayout from '../layouts/BaseLayout.astro';
import FinalCta from './FinalCta.astro';
import GalleryLightbox from './GalleryLightbox.astro';
import PageHero from './PageHero.astro';
import ServiceCard from './ServiceCard.astro';
import { optimizedImageSrc } from '../lib/images';

interface Props {
  service: Service;
  allServices?: Service[];
  allPartners?: Partner[];
}

const { service, allServices = localServices, allPartners = localPartners } = Astro.props;
const whatsappHref = getWhatsAppUrl(service.whatsappMessage);
const preferredImageIndex = service.slug === 'terceirizacao-mao-de-obra' ? 3 : 0;
const displayHero = service.gallery[preferredImageIndex] ?? service.gallery[0] ?? service.heroImage;
const serviceIndex = Object.fromEntries(allServices.map((item) => [item.slug, item])) as Record<string, Service>;
const related = service.relatedSlugs.map((slug) => serviceIndex[slug]).filter(Boolean);
const proofLogos = allPartners.slice(0, 5);
const canonicalUrl = `https://www.nauticaengenharia.com/${service.slug}`;

const schemas = [
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    name: service.title,
    description: service.summary,
    serviceType: service.title,
    url: canonicalUrl,
    image: new URL(displayHero.src, canonicalUrl).toString(),
    areaServed: ['Pernambuco', 'Alagoas', 'Ceará', 'Paraíba', 'Rio Grande do Norte'],
    provider: {
      '@type': 'Organization',
      name: 'Náutica Engenharia e Serviços',
      url: 'https://www.nauticaengenharia.com',
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Início', item: 'https://www.nauticaengenharia.com/' },
      { '@type': 'ListItem', position: 2, name: 'Serviços', item: 'https://www.nauticaengenharia.com/#servicos' },
      { '@type': 'ListItem', position: 3, name: service.title, item: canonicalUrl },
    ],
  },
];
---

<BaseLayout
  title={service.seo.title}
  description={service.seo.description}
  canonicalPath={`/${service.slug}`}
  image={service.seo.image ?? service.heroImage.src}
  imageAlt={service.heroImage.alt}
  schema={schemas}
>
  <PageHero
    eyebrow={service.eyebrow}
    title={service.title}
    summary={service.summary}
    image={displayHero}
    icon={service.icon}
    ctaHref={whatsappHref}
    breadcrumbs={[
      { label: 'Início', href: '/' },
      { label: 'Serviços', href: '/#servicos' },
      { label: service.title },
    ]}
  />

  <section class="section service-intro" aria-labelledby="intro-title">
    <div class="container service-intro-grid">
      <div class="intro-copy">
        <span class="eyebrow">Como atuamos</span>
        <h2 id="intro-title">Uma solução técnica alinhada às condições de cada estrutura.</h2>
        {service.introduction.map((paragraph) => <p>{paragraph}</p>)}
      </div>
      <aside class="intro-panel">
        <Icon name="lucide:clipboard-check" size={34} aria-hidden="true" />
        <span>Escopo técnico</span>
        <strong>Planejamento e execução orientados à necessidade identificada.</strong>
        <a href={whatsappHref} target="_blank" rel="noopener noreferrer">Apresentar minha demanda <Icon name="lucide:arrow-up-right" size={17} aria-hidden="true" /></a>
      </aside>
    </div>
  </section>

  <section class="section technical" aria-labelledby="technical-title">
    <div class="container">
      <div class="section-heading">
        <div>
          <span class="eyebrow">Escopo</span>
          <h2 id="technical-title">{service.technicalHeading}</h2>
        </div>
        <p>{service.closing}</p>
      </div>
      <div class="technical-grid">
        {service.technicalItems.map((item, index) => (
          <article class="technical-card">
            <span aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
            <Icon name="lucide:check-circle-2" size={23} aria-hidden="true" />
            <h3>{item.title}</h3>
            {item.description && <p>{item.description}</p>}
            {item.details && (
              <ul>
                {item.details.map((detail) => <li>{detail}</li>)}
              </ul>
            )}
          </article>
        ))}
      </div>
    </div>
  </section>

  <GalleryLightbox images={service.gallery} title={`Serviços de ${service.title}`} />

  <section class="portfolio-proof" aria-labelledby="proof-title">
    <div class="container proof-inner">
      <div>
        <span>Portfólio institucional</span>
        <h2 id="proof-title">Marcas apresentadas pela Náutica.</h2>
      </div>
      <div class="proof-logos">
        {proofLogos.map((partner) => <img src={optimizedImageSrc(partner.logo.src, 320)} alt={partner.logo.alt} width="180" height="100" loading="lazy" decoding="async" />)}
      </div>
    </div>
  </section>

  {related.length > 0 && (
    <section class="section related" aria-labelledby="related-title">
      <div class="container">
        <div class="section-heading">
          <div>
            <span class="eyebrow">Continue explorando</span>
            <h2 id="related-title">Serviços relacionados</h2>
          </div>
          <p>Outras frentes que podem complementar o escopo da sua operação.</p>
        </div>
        <div class="related-grid">
          {related.map((item, index) => <ServiceCard service={item} index={index} />)}
        </div>
      </div>
    </section>
  )}

  <FinalCta
    eyebrow="Fale com a equipe"
    title={`Precisa de ${service.title.toLocaleLowerCase('pt-BR')}?`}
    description="Compartilhe o contexto da sua estrutura ou operação. A equipe da Náutica dará continuidade pelo WhatsApp."
    href={whatsappHref}
    label="Conversar sobre este serviço"
  />
</BaseLayout>

<style>
  .service-intro-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.3fr) minmax(300px, 0.7fr);
    align-items: start;
    gap: clamp(50px, 9vw, 120px);
  }

  .intro-copy h2 {
    margin-bottom: 28px;
  }

  .intro-copy p {
    max-width: 760px;
    color: var(--ink-muted);
    font-size: 1.03rem;
  }

  .intro-panel {
    position: sticky;
    top: 120px;
    display: grid;
    padding: 34px;
    border-radius: var(--radius-md);
    color: var(--white);
    background: var(--graphite);
    box-shadow: var(--shadow-lg);
  }

  .intro-panel :global(svg) {
    color: var(--brand-orange);
  }

  .intro-panel > span {
    margin: 24px 0 10px;
    color: #ffb29c;
    font-size: 0.7rem;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .intro-panel strong {
    color: var(--white);
    font-size: 1.12rem;
    line-height: 1.5;
  }

  .intro-panel a {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-top: 28px;
    color: var(--white);
    font-size: 0.8rem;
    font-weight: 800;
  }

  .technical {
    background: var(--sand);
  }

  .technical-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 18px;
  }

  .technical-card {
    position: relative;
    min-height: 240px;
    padding: 28px;
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
    background: var(--white);
  }

  .technical-card > span {
    position: absolute;
    top: 24px;
    right: 24px;
    color: var(--ink-muted);
    font-size: 0.72rem;
    font-weight: 900;
  }

  .technical-card > :global(svg) {
    margin-bottom: 24px;
    color: var(--brand-orange-dark);
  }

  .technical-card h3 {
    max-width: 85%;
    margin-bottom: 12px;
    font-family: 'Montserrat', sans-serif;
    font-size: 1.02rem;
  }

  .technical-card p,
  .technical-card li {
    color: var(--ink-muted);
    font-size: 0.83rem;
  }

  .technical-card ul {
    padding-left: 18px;
    margin: 10px 0 0;
  }

  .portfolio-proof {
    padding-block: 48px;
    border-bottom: 1px solid var(--line);
    background: var(--white);
  }

  .proof-inner {
    display: grid;
    grid-template-columns: 280px 1fr;
    align-items: center;
    gap: 50px;
  }

  .proof-inner span {
    color: var(--brand-orange-dark);
    font-size: 0.68rem;
    font-weight: 800;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .proof-inner h2 {
    margin: 8px 0 0;
    font-family: 'Montserrat', sans-serif;
    font-size: 1.25rem;
  }

  .proof-logos {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    align-items: center;
    gap: 24px;
  }

  .proof-logos img {
    width: 100%;
    max-width: 140px;
    height: 68px;
    object-fit: contain;
  }

  .related-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 22px;
  }

  @media (max-width: 900px) {
    .service-intro-grid {
      grid-template-columns: 1fr;
    }

    .intro-panel {
      position: static;
    }

    .technical-grid,
    .related-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .proof-inner {
      grid-template-columns: 1fr;
      gap: 28px;
    }
  }

  @media (max-width: 600px) {
    .technical-grid,
    .related-grid {
      grid-template-columns: 1fr;
    }

    .proof-logos {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
</style>
